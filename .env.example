ADMIN_TOKEN=change-me-to-a-long-random-string
SECRET_KEY=change-me-to-another-long-random-string   # signs login tokens
ALLOW_SIGNUP=true
POSTGRES_PASSWORD=change-me

# Text model (OpenAI-compatible). Gemini:
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
# Used automatically when the main model fails (no key needed). Empty = off; then posts use the offline generator.
LLM_FALLBACK_URL=https://text.pollinations.ai/openai
# ...or your own gateway: LLM_BASE_URL=https://your-gateway/v1  LLM_MODEL=...

# Images: pollinations (free, no key) | cloudflare (Workers AI Flux schnell) | none (brand background)
IMAGE_PROVIDER=pollinations
CF_ACCOUNT_ID=
CF_API_TOKEN=

DAILY_RUN_HOUR=7
TIMEZONE=Asia/Tehran

# Market research
RESEARCH_PROVIDER=free          # free = DuckDuckGo + YouTube search, no keys | gemini = Google Search grounding (falls back to free)
YOUTUBE_API_KEY=                # YouTube Data API v3 (free quota) for most-viewed recent videos
APIFY_TOKEN=                    # optional, paid: Instagram hashtag top posts
