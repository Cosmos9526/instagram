ADMIN_TOKEN=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me

# Text model (OpenAI-compatible). Gemini:
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
# ...or your own gateway: LLM_BASE_URL=https://your-gateway/v1  LLM_MODEL=...

# Images: none (brand gradient) | cloudflare (Workers AI Flux schnell)
IMAGE_PROVIDER=none
CF_ACCOUNT_ID=
CF_API_TOKEN=

DAILY_RUN_HOUR=7
TIMEZONE=Asia/Tehran
